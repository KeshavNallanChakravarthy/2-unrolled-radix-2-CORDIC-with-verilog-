   module Cordic_top #(
    parameter int W = 18
)(
    input  logic clk,
input  logic rst,

    input  logic valid_in,

    input  logic signed [W-1:0]    x_in,
    input  logic signed [W-1:0]    y_in,

    /*
      Phase
     
      32768 = +pi
      16384 = +pi/2
      8192  = +pi/4
      -16384 = -pi/2
      
     */

    input  logic signed [W-1:0] angle_in,

    output logic valid_out,

    output logic signed [W-1:0] x_out,
    output logic signed [W-1:0] y_out
);


     
     //PHASE CONSTANT
     

    localparam logic signed [W-1:0] PI =
        18'sd32768;

    localparam logic signed [W-1:0] HALF_PI =
        18'sd16384;


    /*
     
      QUADRANT PREPROCESSING
     
      CORDIC convers
     
            -99.7 ... +99.7
     
      Therefore map the requested angle into
     
            -90 ... +90
     
      by rotating the input vector by 180.
     
     */

    logic signed [W-1:0] x_pre;
    logic signed [W-1:0] y_pre;
    logic signed [W-1:0] z_pre;


    always_comb begin

        x_pre = x_in;
        y_pre = y_in;
        z_pre = angle_in;

        /*
          Quadrant II
         
          Example:
         
          angle = +120
         
          becomes
         
          angle = -60
         
         while vector is rotated by 180.
         */

        if (angle_in > HALF_PI) begin

            x_pre = -x_in;
            y_pre = -y_in;
            z_pre = angle_in - PI;

        end

        /*
          Quadrant III
         
          Example:
         
          angle = -120
         
          becomes
         
          angle = +60
         */

        else if (angle_in < -HALF_PI) begin

            x_pre = -x_in;
            y_pre = -y_in;
            z_pre = angle_in + PI;

        end

    end


    /*
     
      PIPELINE
     
      8 elementary iterations
    
      Stage 0 -> iterations 0,1
      Stage 1 -> iterations 2,3
      Stage 2 -> iterations 4,5
      Stage 3 -> iterations 6,7
    
     */

    logic signed [W-1:0] x_pipe [0:3];
    logic signed [W-1:0] y_pipe [0:3];
    logic signed [W-1:0] z_pipe [0:3];

    logic valid_pipe [0:3];


    
      //Stage 0
     

    cordic_stage #(
        .W(W),
        .ITER(0)
    ) stage0 (
        .clk(clk),
        .rst(rst),

        .valid_in(valid_in),

        .x_in(x_pre),
        .y_in(y_pre),
        .z_in(z_pre),

        .valid_out(valid_pipe[0]),

        .x_out(x_pipe[0]),
        .y_out(y_pipe[0]),
        .z_out(z_pipe[0])
    );


    
     //Stage 1
     

    cordic_stage #(
        .W(W),
        .ITER(2)
    ) stage1 (
        .clk(clk),
        .rst(rst),

        .valid_in(valid_pipe[0]),

        .x_in(x_pipe[0]),
        .y_in(y_pipe[0]),
        .z_in(z_pipe[0]),

        .valid_out(valid_pipe[1]),

        .x_out(x_pipe[1]),
        .y_out(y_pipe[1]),
        .z_out(z_pipe[1])
    );


    
     // Stage 2
     

    cordic_stage #(
        .W(W),
        .ITER(4)
    ) stage2 (
        .clk(clk),
        .rst(rst),

        .valid_in(valid_pipe[1]),

        .x_in(x_pipe[1]),
        .y_in(y_pipe[1]),
        .z_in(z_pipe[1]),

        .valid_out(valid_pipe[2]),

        .x_out(x_pipe[2]),
        .y_out(y_pipe[2]),
        .z_out(z_pipe[2])
    );


    
     // Stage 3
     

    cordic_stage #(
        .W(W),
        .ITER(6)
    ) stage3 (
        .clk(clk),
        .rst(rst),

        .valid_in(valid_pipe[2]),

        .x_in(x_pipe[2]),
        .y_in(y_pipe[2]),
        .z_in(z_pipe[2]),

        .valid_out(valid_pipe[3]),

        .x_out(x_pipe[3]),
        .y_out(y_pipe[3]),
        .z_out(z_pipe[3])
    );


    /*
  
      CORDIC GAIN
     
      For 8 iterations:
     
      K ~ 1.6467435
     
      Therefore:
     
      1/K ~ 0.6072591
     
      Q2.16 representation:
     
      0.6072591 * 65536 ~ 39797
     
     */

    localparam logic signed [W-1:0] K_INV =
        18'sd39797;


    logic signed [2*W-1:0] x_scaled;
    logic signed [2*W-1:0] y_scaled;


    always_comb begin

        x_scaled = x_pipe[3] * K_INV;
        y_scaled = y_pipe[3] * K_INV;

    end


   //Output

    always_ff @(posedge clk) begin

        if (rst) begin

            x_out     <= '0;
            y_out     <= '0;
            valid_out <= 1'b0;

        end
        else begin

            /*
              Q2.16 * Q2.16
             
              gives Q4.32
             
              shift right by 16
             
              gives Q2.16
             */

            x_out <= x_scaled >>> 16;
            y_out <= y_scaled >>> 16;

            valid_out <= valid_pipe[3];

        end

    end

endmodule
